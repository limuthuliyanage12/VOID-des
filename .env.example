# VOID API. Copy to .env and fill in. Names only, no real values here.
# In production every secret below is required; in development the API falls back to throwaway values.

NODE_ENV=development
PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:4000
CORS_ORIGINS=http://localhost:4000,http://localhost:8000
# Serve apps/web from the API in development, so the site and API share one origin.
SERVE_WEB=true
# Simulated payment helpers under /api/v1/dev. Always off in production.
DEMO_MODE=true

# Database. Transactions need a replica set.
#   Docker:  mongodb://localhost:27017/void?replicaSet=rs0&directConnection=true
#   winget MongoDB service: run once in mongosh  rs.initiate()  after adding  replication: { replSetName: rs0 }  to mongod.cfg
MONGODB_URI=
# Leave empty to run jobs in-process. Set it to use BullMQ and run `pnpm worker`.
#   Docker or Memurai: redis://localhost:6379
REDIS_URL=

# Sessions and encryption at rest (QR signing keys, TOTP secrets). 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_ACCESS_SECRET=
DATA_ENCRYPTION_KEY=
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30
REQUIRE_MFA=false
HIBP_CHECK=false

# PayHere sandbox: sign up at https://sandbox.payhere.lk, add your domain under Settings > Domains & Credentials,
# and copy the Merchant ID and the domain's Merchant Secret. The notify URL must be public HTTPS, so use a tunnel
# (for example `cloudflared tunnel --url http://localhost:4000`) and set API_PUBLIC_URL to it.
PAYHERE_SANDBOX=true
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
# Merchant API app (Settings > API Keys) for refunds. Without it, refunds are simulated outside production.
PAYHERE_APP_ID=
PAYHERE_APP_SECRET=

# Koko BNPL. 'mock' simulates approval locally. 'http' uses qaapi.paykoko.com (sandbox) or prodapi.paykoko.com.
# The Merchant ID, API key and RSA key pair come from the Koko merchant pack. Keys as PEM with \n for newlines.
KOKO_DRIVER=mock
KOKO_SANDBOX=true
KOKO_MERCHANT_ID=
KOKO_API_KEY=
KOKO_PRIVATE_KEY=
KOKO_PUBLIC_KEY=

# Google sign-in (OAuth with PKCE)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/auth.html

# Email (log | resend) and SMS (log | notifylk). 'log' prints and keeps an outbox at /api/v1/dev/outbox.
MAIL_DRIVER=log
RESEND_API_KEY=
MAIL_FROM=VOID <tickets@eventsbythevoid.lk>
SMS_DRIVER=log
NOTIFYLK_USER_ID=
NOTIFYLK_API_KEY=
NOTIFYLK_SENDER_ID=NotifyDEMO

# Files (local | s3). S3 works with Cloudflare R2 by setting S3_ENDPOINT.
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
# ClamAV daemon for upload scanning. Required in production.
CLAMAV_HOST=
CLAMAV_PORT=3310

SENTRY_DSN=
LOG_LEVEL=info
