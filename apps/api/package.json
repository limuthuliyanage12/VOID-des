{
  "name": "@void/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./worker": "./src/jobs/worker.ts",
    "./app": "./src/app.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "dev:mem": "tsx --env-file-if-exists=../../.env src/dev-mem.ts",
    "start": "tsx --env-file-if-exists=../../.env src/index.ts",
    "seed": "tsx --env-file-if-exists=../../.env src/seed/run.ts",
    "seed:check": "tsx --env-file-if-exists=../../.env src/seed/run-check.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@node-rs/argon2": "^2.0.2",
    "@void/shared": "workspace:*",
    "bullmq": "^5.40.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.0",
    "jose": "^6.0.0",
    "mongoose": "^8.15.0",
    "multer": "^2.0.0",
    "pdfkit": "^0.17.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.15.0",
    "@types/pdfkit": "^0.13.9",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^6.0.3",
    "mongodb-memory-server": "^10.1.4",
    "socket.io-client": "^4.8.0",
    "supertest": "^7.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
